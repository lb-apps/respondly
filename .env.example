# Respondly — environment
#
# Copy to `.env.local` for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for the deployment.
# Never commit a filled-in copy: `.gitignore` allows this file and no other.
#
# Per-channel WhatsApp credentials (phone number id, WABA id, access token) do
# NOT live here. They are entered in the dashboard (WhatsApp → Bağlantı) and the
# token is kept in Supabase Vault.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project → Settings → API. The publishable key is public by design (RLS is the
# boundary); the service-role key bypasses RLS and must stay server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for the Meta webhook callback shown in
# the dashboard and for invitation links, so it must be the address customers
# and Meta can actually reach — on Vercel, the production domain.
APP_URL=http://localhost:3000

# Shared secret for the knowledge cron endpoints. The caller is Supabase
# pg_cron, which sends `Authorization: Bearer <secret>`; the same value lives in
# Supabase Vault as `knowledge_cron_secret`.
CRON_SECRET=

# ── Assistant ───────────────────────────────────────────────────────────────
# OpenRouter drives every model call (see `DEFAULT_MODEL`).
OPENROUTER_API_KEY=

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# App-level, shared by every channel. See the table in README.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional. Defaults to v25.0.
WHATSAPP_GRAPH_VERSION=
# Optional. Fallback app id for the Resumable Upload API (profile photos).
WHATSAPP_APP_ID=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Invitations and account mail. EMAIL_FROM is optional; it defaults to
# "Respondly <info@littlebigapps.io>".
RESEND_API_KEY=
EMAIL_FROM=

# ── Knowledge base (all optional) ───────────────────────────────────────────
# Crawl4AI powers multi-page crawling of link sources. Unset disables crawling
# and leaves single-page extraction working — so it is safe to leave empty, but
# the host must be reachable *from the deployment*: a docker container on your
# laptop is not reachable from Vercel.
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
CRAWL4AI_MAX_PAGES=
CRAWL4AI_MAX_DEPTH=
# Raises Jina reader rate limits for link extraction. Works without it.
JINA_API_KEY=
